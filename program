  [{x:1900,y:height-2220},{x:180,y:height-2220},{x:180,y:height-2200},{x:1900,y:height-2200}],
  [{x:1900,y:height-2200},{x:200,y:height-500},{x:220,y:height-480},{x:1920,y:height-2180}],
