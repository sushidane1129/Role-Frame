function draw(){
  background(220);
  cameramove.x=player[0].x-width/2;
  cameramove.y=player[0].y-height/2;
  getPlayerDirection();
  drawdraw();
  drawdetectgrid();
  drawplayermove();
  drawenemymove();
  drawplayerattack();
  drawenemyattack();
  drawplayerhit();
  drawenemyhit();
