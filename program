let cameramove={x:0,y:0};
const gridSize = 30;
const cols=width/gridSize;
const rows=height/gridSize;
let grid=[];
let player=[
  {x:300,y:300,speed:5,radius:15,Maxhp:10,hp:10,directionx:0,directiony:-1,invincible:30}
];
let enemy=[];
const enemyTypes={
  A:{speed:2,distance:60,radius:15,Maxhp:3,invincibletime:30},
  B:{speed:1,distance:50,radius:15,Maxhp:1,invincibletime:40},
