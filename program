}

function spawnEnemy(type,x,y){
  enemy.push({x:x,y:y,type:type,hp:enemyTypes[type].Maxhp,invincible:0,...enemyTypes[type]});
  enemyattack1timecounter.push(0);
}

function normalize(x,y){
  let length=Math.sqrt(x*x+y*y);
  if(length<0.00001) {
    return {x:0, y:0,length:0}; 
  }
  return {x:x/length,y:y/length,length:length};
}

function getPlayerAim(a,b,c,d){
  let x = 0;
  let y = 0;
  if(keyIsDown(a)){
    y-=1;
  }
  if(keyIsDown(b)){
    y+=1;
  }
  if(keyIsDown(c)){
    x-=1;
  }
  if(keyIsDown(d)){
    x+=1;
  }
  return normalize(x, y);
}

function getEnemyAim(enemyx,enemyy,playerx,playery){
  let distance={x:playerx-enemyx,y:playery-enemyy};
  return normalize(distance.x,distance.y)
}

function getPlayerDirection(){
  let x=0;
  let y=0;
  if(keyIsDown(87))y=-1;
  if(keyIsDown(83))y=1;
  if(keyIsDown(65))x=-1;
  if(keyIsDown(68))x=1;
  if(x==0&&y==0) return;
  saveplayerdirection.x=x;
  saveplayerdirection.y=y;
}

function hitTerrain(circle){ 
  let permission=true;
  terrain.forEach(t=>{ 
    for(let i=0;i<4;i++){
      let p1=t[i]; let p2=t[(i+1)%4];
      if(circle.x<=t[3].x&&circle.x>=t[1].x&&circle.y<=t[2].y&&circle.y>=t[0].y){
        if(p1.x-p2.x==0){
          if(circle.x<p1.x+circle.radius&&circle.x>p1.x-circle.radius){
            permission=false;
          } 
        } else {
          let a=(p1.y-p2.y)/(p1.x-p2.x);
          if(a===0){
            if(circle.y<p1.y+circle.radius&&circle.y>p1.y-circle.radius){ 
              permission=false;
            } 
          } 
          if(a>0){
            if(circle.y+circle.x*a<p1.x+p1.y+circle.radius&&circle.y+circle.x*a>p1.x+p1.y-circle.radius){
              permission=false;
            }
          }
          if(a<0){
            if(circle.y+circle.x*a<-p1.x+p1.y+circle.radius&&circle.y+circle.x*a>-p1.x+p1.y-circle.radius){
              permission=false;
            }
          }
        }
      }
    }
  })
  return(permission);
}

function creategrid(){
  for(let n=1;n<cols+1;n++){
    for(let m=1;m<rows+1;m++){
      let inside=false;
      Px=n*gridSize*3/2;
      Py=m*gridSize*3/2;
      for(let t=0;t<terrain.length;t++){
        let Frag=true;
        for(let i=0;i<4;i++){
          let A=terrain[t][i];
          let B=terrain[t][(i+1)%4];
          if((B.x-A.x)*(Py-A.y)-(B.y-A.y)*(Px-A.x)<0){
            Frag=false;
          }
        }
        if(Frag) inside=true;
      }
      if(!inside){
        grid.push(0);
      }
      else grid.push(1);
    }
  }
}

function drawdraw(){
  strokeWeight(3);
  stroke(0)
  fill(255);
  let aim=getPlayerAim(87,83,65,68);
  if(aim.length>0){
    if(saveplayerdirection.x!=0&&saveplayerdirection.y!=0){
      player[0].directionx=saveplayerdirection.x;
      player[0].directiony=saveplayerdirection.y;
      directiontimecounter = 0;
    }
    else{
      directiontimecounter++;
      if(directiontimecounter>=10){
        player[0].directionx=saveplayerdirection.x;
        player[0].directiony=saveplayerdirection.y;
      }
    }
  }
  if(player[0].invincible===0) fill(255);
  else fill(255,255,255,50);
  ellipse(player[0].x-cameramove.x,player[0].y-cameramove.y,(player[0].radius)*2);
  enemy.forEach(e=>{
    if(e.invincible===0) fill(255);
    else fill(255,255,255,50);
    rect(e.x-e.radius-cameramove.x,e.y-e.radius-cameramove.y,(e.radius*2));
  })
  fill(255,0,0);
  stroke(255,0,0);
  ellipse(player[0].x-cameramove.x+player[0].directionx*3,player[0].y-cameramove.y+player[0].directiony*3,5);
  stroke(0);
  fill(165,42,42)
  stroke(0);
  strokeWeight(3);
  fill(165,42,42);
  for(const polygon of terrain){
    beginShape();
    for(const point of polygon){
      vertex(point.x-cameramove.x,point.y-cameramove.y);
    }
    endShape(CLOSE);
  }
}

function drawdetectgrid(){
  let playergrid=floor(player[0].x/gridSize)+floor(player[0].y/gridSize)*cols;
  let griddistance=[];
  //ここでプレイヤーから地形を除く全グリッドへの所要数を調べる
  for(let i=0;i<grid.length;i++){
    if(grid[playergrid+1]==0) {
      griddistance.push(0);
      if(grid[playergrid+2]==0) griddistance.push(0)
      else if(grid[playergrid-1]==0) griddistance.push(0)
    }
  }

  
  for(let i=0;i<grid.length;i++){
    for(let n=0;n<cols;n++){
      for(let m=0;m<rols;m++){
       if(grid[n*m+m]==0) griddistance.push(n*m);
      }
    }
  }
  
  
  for(let e=0;e<enemy.length;e++){
    let enemygrid=floor(enemy[e].x/gridSize)+floor(enemy[e].y/gridSize)*cols;
    //先ほどのデータからどのマスに進むかを判断する
  }
}

function drawplayermove(){
  let aim=getPlayerAim(87,83,65,68);
  player[0].x+=aim.x*player[0].speed;
  player[0].y+=aim.y*player[0].speed;
  playercontrol();
}

function drawenemymove(){
  for(let e=0;e<enemy.length;e++){
    let forward=getEnemyAim(enemy[e].x,enemy[e].y,player[0].x,player[0].y);
    let avoid={x:0,y:0};
    let view=100;
    let strength;
    let terraindistance;
    if(forward.length>enemy[e].distance){
      for(let i=0;i<enemy.length;i++){
        if(e===i) continue;
        let enemydistance=normalize(enemy[i].x-enemy[e].x,enemy[i].y-enemy[e].y);
        if(enemydistance.length>view) continue;
        if(forward.x*enemydistance.x+forward.y*enemydistance.y>0.5){
          strength=((view-enemydistance.length)/view);
          avoid.x-=enemydistance.x*strength;
          avoid.y-=enemydistance.y*strength;
        }
      }
      let move={x:forward.x+avoid.x*1.5,y:forward.y+avoid.y*1.5};
      let normal=normalize(move.x,move.y);
      enemy[e].x+=normal.x*enemy[e].speed;
      enemy[e].y+=normal.y*enemy[e].speed;
      enemycontrol(e,normal);
    }
  }
}

function playercontrol(){
  let over=0;
  for(let k=0;k<3;k++){
    for(let e=0;e<enemy.length;e++){
      let aim=getEnemyAim(player[0].x,player[0].y,enemy[e].x,enemy[e].y);
      over=player[0].radius+enemy[e].radius-aim.length;
      if(over>0){
        enemy[e].x+=aim.x*over/2;
        enemy[e].y+=aim.y*over/2;
        player[0].x-=aim.x*over/2;
        player[0].y-=aim.y*over/2;
      }
    }
  }
  let permission=hitTerrain(player[0]);
  if(!permission){
    player[0].x-=saveplayerdirection.x*player[0].speed;
    player[0].y-=saveplayerdirection.y*player[0].speed;
  }
}

function enemycontrol(e,n){
  let over=0;
  for(let k=0;k<3;k++){
    for(let i=e+1;i<enemy.length;i++){
      let aim=getEnemyAim(enemy[i].x,enemy[i].y,enemy[e].x,enemy[e].y);
      if(e===i){
        continue;
      }
      over=enemy[e].radius+enemy[i].radius-aim.length;
      if(over>0){
        enemy[e].x-=aim.x*over/2;
        enemy[e].y-=aim.y*over/2;
        enemy[i].x+=aim.x*over/2;
        enemy[i].y+=aim.y*over/2;
      }
    }
  }
  let permission=hitTerrain(enemy[e]);
  if(!permission){
    enemy[e].x-=n.x*enemy[e].speed;
    enemy[e].y-=n.y*enemy[e].speed;
  }
}

function drawplayerattack(){
  if(player[0].directionx!=0&&player[0].directiony!=0){
    playerattack1={x:player[0].x+(player[0].radius+20)*player[0].directionx,
                   y:player[0].y+(player[0].radius+20)*player[0].directiony,
                   radius:20,
                   damage:1
                  };
  }
  else if(player[0].directionx===0){
    playerattack1={x:player[0].x,
                   y:player[0].y+(player[0].radius+20)*player[0].directiony,
                   radius:20,
                   damage:1
                  };
  }
  else{
    playerattack1={x:player[0].x+(player[0].radius+20)*player[0].directionx,
                   y:player[0].y,
                   radius:20,
                   damage:1
                  };
  }
  if(playerattack1timecounter>=120) playerattack1timecounter=0;
  if(playerattack1timecounter<30){
    if(keyIsDown(69)){
      if(playerattack1timecounter===0){
      fill(0)
//      console.log("attack1");
        playerattack1timecounter+=1
      }
      strokeWeight(0);
      fill(255,0,0);
      rect(playerattack1.x-playerattack1.radius-cameramove.x,
           playerattack1.y-playerattack1.radius-cameramove.y,
           playerattack1.radius*2);
    }
  }
  if(playerattack1timecounter!=0) playerattack1timecounter+=1;
}

function drawenemyattack(){
  for(let e=0;e<enemy.length;e++){
    if(enemyattack1timecounter[e]>=180) enemyattack1timecounter[e]=0;
    let aim=getEnemyAim(enemy[e].x,enemy[e].y,player[0].x,player[0].y);
    if(enemyattack1timecounter[e]===0&&aim.length<=enemy[e].distance+80){
      enemyattack1.push({x:enemy[e].x,y:enemy[e].y,radius:8,speed:2,damage:1,vectorx:aim.x,vectory:aim.y,life:120});
      enemyattack1timecounter[e]+=1;
    }
    if(enemyattack1timecounter[e]!=0) enemyattack1timecounter[e]+=1;
  }
  for(let i=enemyattack1.length-1;i>=0;i--){
    enemyattack1[i].x=enemyattack1[i].x+enemyattack1[i].vectorx*enemyattack1[i].speed;
    enemyattack1[i].y=enemyattack1[i].y+enemyattack1[i].vectory*enemyattack1[i].speed;
    enemyattack1[i].life-=1
    strokeWeight(0);
    stroke(0);
    fill(40,255,60);
    ellipse(enemyattack1[i].x-cameramove.x,enemyattack1[i].y-cameramove.y,enemyattack1[i].radius*2);
    if(enemyattack1[i].life<=0) enemyattack1.splice(i,1);
  }
}

function drawplayerhit(){
  for(let i=enemyattack1.length-1;i>=0;i--){
    if(player[0].invincible===0){
      let forward=getEnemyAim(player[0].x,player[0].y,enemyattack1[i].x,enemyattack1[i].y)
      if(forward.length<player[0].radius+enemyattack1[i].radius){
        player[0].invincible=60
        playertakeattack(i);
      }
    }
  }
  if(player[0].invincible!=0) player[0].invincible-=1
}

function drawenemyhit(){
  for(let e=0;e<enemy.length;e++){
    if(playerattack1timecounter>0&&playerattack1timecounter<30&&enemy[e].invincible===0){
      let forward=getEnemyAim(enemy[e].x,enemy[e].y,playerattack1.x,playerattack1.y)
      if(forward.length<enemy[e].radius+playerattack1.radius){
        enemy[e].invincible=enemy[e].invincibletime;
        enemytakeattack(e);
      }
    }
    if(enemy[e].invincible!=0) enemy[e].invincible-=1;
  }
}

